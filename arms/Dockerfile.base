# Common base for all arm images and the harness service (isolation-docker-compose ADR).
# No credential ARG/ENV: the key reaches containers only via compose env_file.
FROM node:22

# pinned CLI; bump requires rebuilding every arm
RUN npm install -g @anthropic-ai/claude-code@2.1.285

# Fixture/postcheck runtime (scenario-matrix ADR: pytest fixtures, in-container
# checks). Missing pytest failed every test-based postcheck in the first full
# matrix ("No module named pytest"), so it is pinned into the shared base for
# arms (subjects run the fixture suite) and the harness service (postchecks).
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pytest \
    && rm -rf /var/lib/apt/lists/*

# Arm template HOME: plugins baked here at build survive the per-trial
# throwaway $HOME (the entrypoint seeds $HOME from it). Init hooks in
# /opt/arm-init.d run after the seed, before the command (verbosity-policy ADR).
RUN mkdir -p /opt/arm-home /opt/arm-init.d && chown -R node:node /opt/arm-home
COPY --chmod=755 arm-entrypoint.sh /usr/local/bin/arm-entrypoint.sh

# throwaway HOME is mounted per trial by the runner
USER node
WORKDIR /work
ENTRYPOINT ["arm-entrypoint.sh"]
CMD ["bash"]
