# Copy to .env (gitignored). Both lines are required.
CLAUDE_CODE_OAUTH_TOKEN=
# Subject model for every arm. The judge and simulator pin their own models
# and ignore this. REPORT.md records the model actually billed.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: benchmark an unpublished ni checkout instead of the latest release.
# The report shows its version as <version>+local.<sha>.
#NI_LOCAL_SRC=/path/to/natural-intelligence
